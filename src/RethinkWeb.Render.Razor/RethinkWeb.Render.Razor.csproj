  <PropertyGroup>
    <RootNamespace>RethinkWeb.Render.Razor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- AspNetCore.App brings Microsoft.AspNetCore.Components.Web (HtmlRenderer)
         at the version of the host runtime — avoids version drift with hosts. -->
