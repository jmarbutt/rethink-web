@* Outer HTML shell. HTMX + Alpine via CDN — no build step. *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Title</title>
    <script src="https://unpkg.com/htmx.org@@2.0.3"></script>
    <script defer src="https://unpkg.com/alpinejs@@3.14.3/dist/cdn.min.js"></script>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 1200px; margin: 2rem auto; padding: 0 1rem; color: #1a1a1a; }
        h1, h2 { color: #111; }
        table { border-collapse: collapse; width: 100%; }
        th, td { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #e5e5e5; }
        th { background: #fafafa; font-weight: 600; }
        tr:hover td { background: #f6f9ff; }
        form { display: grid; gap: 0.75rem; max-width: 600px; }
        label { display: grid; gap: 0.25rem; font-size: 0.9rem; color: #555; }
        input, select, textarea { padding: 0.5rem; font: inherit; border: 1px solid #ccc; border-radius: 4px; }
        input[disabled] { background: #f4f4f4; color: #888; }
        button { padding: 0.5rem 1rem; background: #2563eb; color: white; border: 0; border-radius: 4px; cursor: pointer; }
        button:hover { background: #1e40af; }
        .row-actions { display: flex; gap: 0.5rem; }
        nav { margin-bottom: 1rem; }
        nav a { color: #2563eb; margin-right: 1rem; text-decoration: none; }
        nav a:hover { text-decoration: underline; }
        .toast { padding: 0.75rem; background: #ecfccb; border-left: 4px solid #65a30d; margin-bottom: 1rem; }
    </style>
</head>
<body>
    <nav>
        <a href="/">Home</a>
        <a href="/_framework/manifest" target="_blank">Manifest (JSON)</a>
    </nav>
    <main id="main">
        @((MarkupString)ContentHtml)
    </main>
</body>
</html>

@code {
    [Parameter] public string Title { get; set; } = "RethinkWeb";
    [Parameter] public string ContentHtml { get; set; } = string.Empty;
}
